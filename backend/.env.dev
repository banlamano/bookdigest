# Development Environment Configuration
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000

# SQLite Database (for local development - no PostgreSQL needed)
DATABASE_URL="file:./dev.db"

# JWT Authentication (development key - change for production)
JWT_SECRET=dev-secret-key-change-in-production-very-important
JWT_EXPIRE=7d

# Stripe (use test keys for development)
STRIPE_SECRET_KEY=sk_test_your_stripe_test_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_test_key
STRIPE_WEBHOOK_SECRET=whsec_test_your_webhook_secret

# Stripe Price IDs (create in Stripe Dashboard)
STRIPE_PRICE_MONTHLY=price_test_monthly
STRIPE_PRICE_YEARLY=price_test_yearly
STRIPE_PRICE_TEAM=price_test_team

# AWS S3 (optional for local dev - can use local storage)
AWS_ACCESS_KEY_ID=optional_for_local_dev
AWS_SECRET_ACCESS_KEY=optional_for_local_dev
AWS_REGION=eu-central-1
AWS_S3_BUCKET=bookdigest-audio-dev

# Email (optional for local dev)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_pass
EMAIL_FROM=dev@bookdigest.local

# Google Books API (optional)
GOOGLE_BOOKS_API_KEY=optional_for_local_dev

# Google Gemini AI (for summary generation)
GEMINI_API_KEY=AIzaSyBHz9_UrFxS89_5BknKc60FWXEAuzFILGY

# Admin Panel Secret Key
ADMIN_SECRET_KEY=bookdigest-secure-admin-2026-key

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
