# Server Configuration
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/bookdigest?schema=public"

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# Stripe Payment
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Subscription Prices (Price IDs from Stripe)
STRIPE_PRICE_MONTHLY=price_monthly_id
STRIPE_PRICE_YEARLY=price_yearly_id
STRIPE_PRICE_TEAM=price_team_id

# AWS S3 (for audio files)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=bookdigest-audio

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@bookdigest.com

# Google Books API (for book metadata)
GOOGLE_BOOKS_API_KEY=your_google_books_api_key

# Google Gemini AI (for summary generation)
GEMINI_API_KEY=your_gemini_api_key

# Analytics (optional)
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Admin Panel
ADMIN_SECRET_KEY=your-admin-secret-key-change-this
ADMIN_SECRET=your-admin-secret-change-this

# Email Service (Resend)
RESEND_API_KEY=re_your_api_key_here
FROM_EMAIL=BookDigest <onboarding@resend.dev>

# Unsubscribe link HMAC secret. Falls back to JWT_SECRET, then a hardcoded
# default, but set a dedicated value in production so the two secrets can
# rotate independently. If this changes, every unsubscribe link previously
# emailed becomes invalid.
UNSUBSCRIBE_SECRET=change-this-in-production

# Public-facing API URL — used to build absolute unsubscribe links in
# email footers. Falls back to API_URL or the Render host.
PUBLIC_API_URL=https://bookdigest-lypx.onrender.com

# Resend Audience IDs for one-way DB → Resend sync. Create the Audiences
# in Resend's dashboard, then paste the IDs here. If unset, the sync code
# silently no-ops — nothing breaks. Once set, every new signup is
# auto-added and every unsubscribe is mirrored.
RESEND_AUDIENCE_EN_ID=
RESEND_AUDIENCE_DE_ID=
