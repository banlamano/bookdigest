    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.5",
        "@types/multer": "^1.4.11",
        "@types/node": "^20.11.5",
        "@types/nodemailer": "^6.4.14",
        "better-sqlite3": "^12.8.0",
        "dotenv-cli": "^11.0.0",
        "pg": "^8.18.0",
        "prisma": "^5.8.1",
        "sqlite3": "^5.1.7"
