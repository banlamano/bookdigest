{
    "name": "bookdigest-backend",
    "version": "1.0.0",
    "main": "dist/server.js",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "npx prisma generate",
        "start": "npx tsx src/server.ts",
        "postinstall": "npx prisma generate",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "prisma:studio": "prisma studio",
        "prisma:seed": "tsx prisma/seed.ts",
        "prisma:seed:extended": "tsx prisma/seed-extended.ts",
        "prisma:seed:massive": "tsx prisma/seed-massive.ts",
        "prisma:seed:google": "tsx prisma/seed-google-books.ts",
        "prisma:seed:500": "tsx prisma/seed-500-books.ts",
        "generate:summaries": "tsx prisma/generate-summaries.ts",
        "regenerate:summaries": "tsx src/scripts/regenerate-summaries.ts",
        "setup:dev": "npm run prisma:generate && npm run prisma:migrate && npm run prisma:seed",
        "update-covers": "tsx src/scripts/update-covers.ts",
        "generate:audio": "tsx src/scripts/generate-audio-google.ts",
        "generate:audio:polly": "tsx src/scripts/generate-audio-polly.ts",
        "broadcast:audio-announcement": "tsx src/scripts/broadcast-audio-announcement.ts",
        "email:stats": "tsx src/scripts/email-stats.ts",
        "resend:sync-audience": "tsx src/scripts/sync-resend-audience.ts"
    },
    "prisma": {
        "seed": "tsx prisma/seed.ts"
    },
    "dependencies": {
        "@google/generative-ai": "^0.24.1",
        "@prisma/client": "^5.8.1",
        "@supabase/supabase-js": "^2.98.0",
        "aws-sdk": "^2.1543.0",
        "axios": "^1.13.5",
        "bcryptjs": "^2.4.3",
        "cors": "^2.8.5",
        "dotenv": "^16.4.1",
        "express": "^4.18.2",
        "express-rate-limit": "^7.1.5",
        "express-validator": "^7.0.1",
        "helmet": "^7.1.0",
        "jsonwebtoken": "^9.0.2",
        "multer": "^1.4.5-lts.1",
        "node-cron": "^3.0.3",
        "node-fetch": "^2.7.0",
        "nodemailer": "^6.9.8",
        "openai": "^6.20.0",
        "resend": "^6.9.1",
        "stripe": "^14.14.0",
        "tsx": "^4.7.0",
        "typescript": "^5.3.3",
        "winston": "^3.11.0"
